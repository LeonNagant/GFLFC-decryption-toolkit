# 统一使用 LF，避免 Windows/Linux 之间换行符来回改动
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# 明确标记为二进制，防止 Git 尝试做文本转换
*.ab    binary
*.apk   binary
*.assets binary
*.bundle binary
*.png   binary
*.ttf   binary
